{
  "$id": "https://project-aurora.com/schemas/search-result.json",
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Search Result Schema",
  "description": "Schema for search result items extracted from listings",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The title of the search result item"
    },
    "metadata": {
      "type": "string",
      "description": "Additional metadata like publication date, category"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL link to the full item"
    },
    "content": {
      "type": "string",
      "description": "Snippet or preview content"
    },
    "category": {
      "type": "string",
      "description": "Item category or classification"
    }
  },
  "required": ["title"],
  "additionalProperties": false
}
